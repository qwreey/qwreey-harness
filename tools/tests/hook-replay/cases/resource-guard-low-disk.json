{
 "description": "resource-guard: low free space is warned once per session, with thresholds from the plugin's userConfig (settings.json pluginConfigs). The cwd is /proc, whose statvfs is always 0 free of 0, so the warning text does not depend on the host's real disk; the real temp disk stays above the 0.001 GiB threshold. CLAUDE_PLUGIN_DATA is set as Claude Code does: without it the state folder name needs the user name, which simwin cannot give (no pwd, no USER in the sandbox)",
 "files": {
  "{cfg}/settings.json": {"text": "{\"pluginConfigs\": {\"qwreey-proc-guard@qwreey-harness\": {\"options\": {\"proc_guard_disk_min_free_gib\": 0.001, \"proc_guard_disk_min_free_pct\": 0, \"proc_guard_core\": false}}}}\n"}
 },
 "env": {"CLAUDE_PLUGIN_DATA": "{sandbox}/rgdata"},
 "steps": [
  {
   "hook": "plugins/qwreey-proc-guard/hooks/resource-guard.py",
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_use_id": "t1", "cwd": "/proc", "tool_input": {"command": "ls"}},
   "expect": {
    "tags": ["resource-guard/warn"],
    "contains": ["Low disk space before this command: /proc has 0.0 GiB free (100.0% of 0.0 GiB; the warning starts below 0.001 GiB or 0%).",
                 "Tell the user in one line: the mount and its free GiB.", "A full disk breaks builds"]
   }
  },
  {
   "note": "the same warning is not repeated in this session",
   "hook": "plugins/qwreey-proc-guard/hooks/resource-guard.py",
   "payload": {"hook_event_name": "PostToolUse", "tool_name": "Bash", "tool_use_id": "t1", "cwd": "/proc", "tool_input": {"command": "ls"},
               "tool_response": {"stdout": "a\n", "stderr": "", "interrupted": false, "isImage": false}},
   "expect": {"empty": true}
  },
  {
   "hook": "plugins/qwreey-proc-guard/hooks/resource-guard.py",
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_use_id": "t2", "cwd": "/proc", "tool_input": {"command": "ls"}},
   "expect": {"empty": true}
  },
  {
   "note": "another session warns again",
   "hook": "plugins/qwreey-proc-guard/hooks/resource-guard.py",
   "payload": {"session_id": "s2", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_use_id": "t3", "cwd": "/proc", "tool_input": {"command": "ls"}},
   "expect": {"tags": ["resource-guard/warn"], "contains": ["Low disk space before this command: /proc"]}
  },
  {
   "note": "the project's own disk is above the threshold",
   "hook": "plugins/qwreey-proc-guard/hooks/resource-guard.py",
   "payload": {"session_id": "s3", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_use_id": "t4", "tool_input": {"command": "ls"}},
   "expect": {"empty": true}
  },
  {
   "note": "PROC_GUARD_DISK=off turns the disk check off (the environment wins over the option)",
   "hook": "plugins/qwreey-proc-guard/hooks/resource-guard.py",
   "env": {"PROC_GUARD_DISK": "off"},
   "payload": {"session_id": "s4", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_use_id": "t5", "cwd": "/proc", "tool_input": {"command": "ls"}},
   "expect": {"empty": true}
  },
  {
   "note": "other tools are ignored",
   "hook": "plugins/qwreey-proc-guard/hooks/resource-guard.py",
   "payload": {"session_id": "s5", "hook_event_name": "PreToolUse", "tool_name": "Read", "tool_use_id": "t6", "cwd": "/proc", "tool_input": {"file_path": "x"}},
   "expect": {"empty": true}
  }
 ]
}
