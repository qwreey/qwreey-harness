{
 "description": "workspace-gate load marker: the slash command and the Skill tool load it per (session, agent, epoch); other skills do not; a compact epoch file resets it; a state file that is not a JSON object lets the call pass like python",
 "steps": [
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["UserPromptExpansion"],
   "payload": {"hook_event_name": "UserPromptExpansion", "expansion_type": "slash_command", "command_name": "q:back"},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Write", "tool_input": {"file_path": "{ws}/other/a.txt"}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["UserPromptExpansion"],
   "payload": {"hook_event_name": "UserPromptExpansion", "expansion_type": "slash_command", "command_name": "qwreey-workspace:workspace"},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "MultiEdit", "tool_input": {"file_path": "{ws}/other/a.txt"}},
   "expect": {"empty": true}},
  {"note": "a subagent has its own marker",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"agent_id": "a/1", "hook_event_name": "PreToolUse", "tool_name": "NotebookEdit", "tool_input": {"notebook_path": "{ws}/other/n.ipynb"}},
   "expect": {"decision": "deny"}},
  {"note": "python re `$` also matches before a final newline",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PostToolUse"],
   "payload": {"agent_id": "a/1", "hook_event_name": "PostToolUse", "tool_name": "Skill", "tool_input": {"skill": "workspace\n"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"agent_id": "a/1", "hook_event_name": "PreToolUse", "tool_name": "NotebookEdit", "tool_input": {"notebook_path": "{ws}/other/n.ipynb"}},
   "expect": {"empty": true}},
  {"write": {"{tmp}/claude-qwreey-workspace-epoch/s1": " 2\n"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "{ws}/other/a.txt"}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PostToolUse"],
   "payload": {"hook_event_name": "PostToolUse", "tool_name": "Skill", "tool_input": {"skill": "x.y-z:workspace"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "{ws}/other/a.txt"}},
   "expect": {"empty": true}},
  {"write": {"{tmp}/claude-workspace-gate/s9.c0.json": "[1]\n"}},
  {"note": "python st.get() on a list raises, the hook prints nothing",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "s9", "hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "{ws}/other/a.txt"}},
   "expect": {"empty": true}},
  {"write": {"{tmp}/claude-workspace-gate/s8.c0.json": "{\"loaded\": 0, \"warned\": true, \"extra\": [NaN]}"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "s8", "hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "{ws}/other/a.txt"}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PostToolUse"],
   "payload": {"session_id": "s8", "hook_event_name": "PostToolUse", "tool_name": "Skill", "tool_input": {"skill": "qwreey-workspace:workspace"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "s8", "hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "{ws}/other/a.txt"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["Stop"],
   "payload": {"hook_event_name": "Stop"},
   "expect": {"empty": true}}
 ]
}
