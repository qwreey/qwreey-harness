{
 "description": "sibling-internals path forms: backslash and ~/ forms, several siblings in one note, Edit and MultiEdit text, non-str content str()-ed like python, per-agent and per-epoch dedup, odd seen files",
 "files": {
  "{ws}/other/src/engine.py": "x = 1\n",
  "{home}/hrepo/.git/HEAD": "ref: refs/heads/main\n",
  "{home}/hrepo/lib/a.py": "a\n"
 },
 "env": {
  "HARNESS_WORKSPACE": "{ws}",
  "HARNESS_WORKSPACE_EXTRA": "{home}/hrepo"
 },
 "steps": [
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/research/a.md",
    "content": "See ..\\..\\other\\src\\engine.py, ~/hrepo/lib/a.py and {home}\\hrepo\\lib\\b.py; also `../x-kb/skills/a.md`.\n"}},
   "expect": {"tags": ["sibling-internals/info"], "contains": ["sibling repos `hrepo` (2, e.g. `~/hrepo/lib/a.py`), `other` (1, e.g. `..\\..\\other\\src\\engine.py`), `x-kb` (1, e.g. `../x-kb/skills/a.md`)"]}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"agent_id": "a1", "hook_event_name": "PostToolUse", "tool_name": "Edit", "tool_input": {"file_path": "{repo}/.claude/research/a.md", "old_string": "x", "new_string": "../other/src/engine.py"}},
   "expect": {"tags": ["sibling-internals/info"]}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"agent_id": "a1", "hook_event_name": "PostToolUse", "tool_name": "MultiEdit", "tool_input": {"file_path": "{repo}/.claude/research/a.md", "edits": [{"new_string": "../other/b"}, "skip", {"new_string": 5}]}},
   "expect": {"empty": true}},
  {"note": "str(['../other/x']) still names the path",
   "hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/research/b.md", "content": ["../other/x", 1]}},
   "expect": {"contains": ["1 internal path of sibling repo `other` (e.g. `../other/x`)"]}},
  {"write": {"{tmp}/claude-qwreey-workspace-epoch/s1": "1"}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/research/b.md", "content": "../other/x"}},
   "expect": {"tags": ["sibling-internals/info"]}},
  {"write": {"{tmp}/claude-workspace-sibling/s2.c0.json": "{\"seen\": \"xyz\"}"}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"session_id": "s2", "hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/research/c.md", "content": "../other/x"}},
   "expect": {"tags": ["sibling-internals/info"]}},
  {"write": {"{tmp}/claude-workspace-sibling/s3.c0.json": "{\"seen\": [1, \"a\"]}"}},
  {"note": "python sorted() of str and int raises when it writes the seen file",
   "hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"session_id": "s3", "hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/research/c.md", "content": "../other/x"}},
   "expect": {"empty": true}},
  {"write": {"{tmp}/claude-workspace-sibling/s4.c0.json": "{\"seen\": 5}"}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"session_id": "s4", "hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/research/c.md", "content": "../other/x"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"session_id": "s5", "hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/research/d.md",
    "content": "x../other/a, a/../other/b, `../../other/../c`, ../other/. and ../other/src/engine.py:12 " }},
   "expect": {"contains": ["2 internal paths of sibling repo `other` (e.g. `../other/b`)"]}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py", "payload": "[\"not\", \"a\", \"dict\"]", "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"cwd": 3, "hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": ".claude/research/e.md", "content": "../other/a"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"cwd": 3, "session_id": "s6", "hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/research/e.md", "content": "../other/a"}},
   "expect": {"tags": ["sibling-internals/info"]}},
  {"hook": "plugins/qwreey-workspace/scripts/sibling_notice.py",
   "payload": {"session_id": "s7", "hook_event_name": "PostToolUse", "tool_name": "Write", "tool_input": {"file_path": "{repo}/.claude/settings.json\n", "content": "../other/a"}},
   "expect": {"empty": true}}
 ]
}
