{
 "description": "reply-language: asks once for an unknown language, counts tool calls per prompt for the long-turn reminder, flags interim English text with a cooldown, and lets an English reply through when the user wrote English",
 "env": {
  "CLAUDE_PLUGIN_DATA": "{sandbox}/data"
 },
 "files": {
  "{sandbox}/t/main.jsonl": [
   {
    "type": "user",
    "message": {
     "role": "user",
     "content": "이 파일 고쳐 줘"
    }
   },
   {
    "type": "assistant",
    "message": {
     "role": "assistant",
     "content": [
      {
       "type": "text",
       "text": "I read the file and added the function. The tests pass and nothing else needs attention."
      },
      {
       "type": "tool_use",
       "name": "Bash",
       "input": {}
      }
     ]
    }
   },
   {
    "type": "assistant",
    "message": {
     "role": "assistant",
     "content": [
      {
       "type": "text",
       "text": "파일을 읽고 함수를 추가했습니다. 테스트도 통과했고 따로 걸리는 점은 없습니다."
      },
      {
       "type": "tool_use",
       "name": "Bash",
       "input": {}
      }
     ]
    }
   }
  ],
  "{sandbox}/t/en.jsonl": [
   {
    "type": "user",
    "message": {
     "role": "user",
     "content": "please fix this file"
    }
   },
   {
    "type": "user",
    "message": {
     "role": "user",
     "content": [
      {
       "type": "tool_result",
       "content": "x"
      }
     ]
    }
   },
   {
    "type": "user",
    "message": {
     "role": "user",
     "content": "meta"
    },
    "isMeta": true
   }
  ],
  "{sandbox}/t/ko.jsonl": [
   {
    "type": "user",
    "message": {
     "role": "user",
     "content": [
      {
       "type": "text",
       "text": "```\nlog\n```"
      },
      {
       "type": "text",
       "text": "이거 왜 깨져?"
      }
     ]
    }
   }
  ]
 },
 "steps": [
  {
   "hook": "plugins/qwreey-reply-language/hooks/reply_language.py",
   "payload": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "hi"
   },
   "expect": {
    "tags": [
     "reply-language/info"
    ],
    "contains": [
     "No reply language is configured"
    ]
   }
  },
  {
   "hook": "plugins/qwreey-reply-language/hooks/reply_language.py",
   "payload": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "hi"
   },
   "expect": {
    "empty": true
   }
  },
  {
   "hook": "plugins/qwreey-reply-language/hooks/reply_language.py",
   "payload": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "hi",
    "agent_id": "a1",
    "session_id": "s9"
   },
   "expect": {
    "empty": true
   }
  },
  {
   "hook": "plugins/qwreey-reply-language/hooks/reply_language.py",
   "payload": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "hi",
    "session_id": "s8"
   },
   "expect": {
