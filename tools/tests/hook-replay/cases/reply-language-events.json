  },
  {
   "hook": "plugins/qwreey-reply-language/hooks/reply_language.py",
   "payload": {
    "hook_event_name": "Stop",
    "last_assistant_message": "파일을 읽고 함수를 추가했습니다. 테스트도 통과했고 따로 걸리는 점은 없습니다."
   },
   "expect": {
