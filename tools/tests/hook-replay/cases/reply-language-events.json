    "hook_event_name": "UserPromptSubmit",
    "prompt": "hi",
    "session_id": "s7"
   },
   "expect": {
    "empty": true
   }
  },
  {
   "hook": "plugins/qwreey-reply-language/hooks/reply_language.py",
   "payload": {
    "hook_event_name": "PostToolBatch",
    "session_id": "b1",
    "prompt_id": "p1",
    "tool_calls": [
     {},
     {},
     {},
     {}
    ]
   },
   "expect": {
    "empty": true
   }
  },
  {
