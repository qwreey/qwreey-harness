{
 "description": "bash: a read-only interpreter command is info only, takes no snapshot, so the post hook stays silent",
 "files": {
  "src/a.py": "x = 1\n"
 },
 "setup": [
  "git add -A && git commit -qm init"
 ],
 "steps": [
  {
   "hook": "plugins/qwreey-conventions/hooks/bash-bypass-reminder.py",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "python3 -c \"print(open('src/a.py').read())\""
    },
    "tool_use_id": "t1"
   },
   "expect": {
    "tags": [
     "bash-bypass-reminder/info"
    ],
    "not_contains": [
     "level=\"warn\""
    ]
   }
  },
  {
   "hook": "plugins/qwreey-conventions/hooks/bash_writes.py",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "PostToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "python3 -c \"print(open('src/a.py').read())\""
    },
    "tool_use_id": "t1"
   },
   "expect": {
    "empty": true
   }
  },
  {
   "hook": "plugins/qwreey-conventions/hooks/bash-bypass-reminder.py",
   "payload": {
    "session_id": "s2",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "git status"
    },
    "tool_use_id": "t1"
   },
   "expect": {
    "empty": true
   }
  }
 ]
}
