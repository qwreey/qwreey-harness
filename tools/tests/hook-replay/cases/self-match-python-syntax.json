    }
   },
   "expect": {
    "exit": 0,
    "empty": true
   }
  },
  {
   "note": "single-character repeats backtrack over a long run of spaces before the z in the pattern itself matches",
   "hook": "plugins/qwreey-proc-guard/hooks/self-match-guard.py",
   "payload": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "echo '                                                                                                                                                                                                                                                          ' >/dev/null; while pgrep -f ' * * *z' >/dev/null; do sleep 1; done"
    }
   },
   "expect": {
    "decision": "deny",
    "tags": [
     "self-match-guard/action"
    ]
   }
  }
 ]
