{
 "description": "self-match-guard: patterns python reads but the Rust port does not translate (scoped flags, verbose mode, \\N{...}) never deny, python 3.14's \\z, a pattern nested past python's recursion limit is silent, and a slow single-character repeat stays fast",
 "steps": [
  {
   "note": "scoped flags: python reads the pattern and it does not match the command; the Rust port, which does not read them, must pass too",
   "hook": "plugins/qwreey-proc-guard/hooks/self-match-guard.py",
   "payload": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "while pgrep -f '(?i:x)y'; do sleep 1; done"
    }
   },
   "expect": {
    "empty": true
   }
  },
  {
   "hook": "plugins/qwreey-proc-guard/hooks/self-match-guard.py",
   "payload": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "while pgrep -f '(?x)a b'; do sleep 1; done"
    }
   },
   "expect": {
    "empty": true
   }
  },
  {
   "hook": "plugins/qwreey-proc-guard/hooks/self-match-guard.py",
   "payload": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "while pgrep -f '\\N{EM DASH}'; do sleep 1; done"
    }
   },
   "expect": {
    "empty": true
   }
  },
  {
   "note": "repeat counts over 1000",
   "hook": "plugins/qwreey-proc-guard/hooks/self-match-guard.py",
   "payload": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "until ! pgrep -f 'x{2000}'; do sleep 1; done"
    }
   },
   "expect": {
    "empty": true
   }
  },
  {
   "note": "python 3.14 reads \\z as end of string",
   "hook": "plugins/qwreey-proc-guard/hooks/self-match-guard.py",
   "payload": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
     "command": "while pgrep -f 'done\\z'; do sleep 1; done"
    }
   },
   "expect": {
    "decision": "deny",
    "tags": [
     "self-match-guard/action"
    ]
   }
  },
  {
   "note": "nesting past python's recursion limit: python stops with RecursionError and prints nothing",
