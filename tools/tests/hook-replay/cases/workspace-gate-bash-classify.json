{
 "description": "workspace-gate Bash classifier: writes to another repo (rm, cp target, redirects, git -C, cd then relative write, interpreter writes, $HOME and ~ paths, .. paths) are denied; reads note once per session; own-repo and unrelated commands pass; two repos in one command name the first written",
 "files": {
  "{home}/proj/.git/HEAD": "ref: refs/heads/main\n"
 },
 "steps": [
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w1", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "rm -rf {ws}/other/build"}},
   "expect": {"decision": "deny", "tags": ["workspace-gate/action"], "contains": ["This changes the repo `{ws}/other`"]}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w2", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "cp ./a.md {ws}/x-kb/notes.md"}},
   "expect": {"decision": "deny", "contains": ["`{ws}/x-kb`"]}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w3", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "echo x 2>{ws}/other/log; echo y >&2"}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w4", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git -C ../other commit -am wip"}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w5", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "cd ../other && echo hi >> NOTES"}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w6", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "python3 -c \"open('{ws}/other/a.py','w').write('x')\""}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w7", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "sudo FOO=1 nice -n 5 touch $HOME/proj/a ${HOME}/proj/b ~/proj/c"}},
   "expect": {"decision": "deny", "contains": ["This changes the repo `~/proj`"]}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w8", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "echo x > {repo}/../other/./a"}},
   "expect": {"decision": "deny", "contains": ["`{ws}/other`"]}},
  {"note": "both repos are written: the first one in the command is named",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w9", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "rm {ws}/x-kb/a {ws}/other/b {ws}/x-kb/c"}},
   "expect": {"decision": "deny", "contains": ["`{ws}/x-kb`"]}},
  {"note": "a read of one repo and a write of another: the write wins",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w10", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "cat {ws}/x-kb/README.md | tee {ws}/other/copy.md"}},
   "expect": {"decision": "deny", "contains": ["`{ws}/other`"]}},
  {"note": "the cwd is another repo but the only write is an absolute path in this repo",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "r1", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "cd {ws}/other && rm {repo}/tmp.txt"}},
   "expect": {"decision": null, "tags": ["workspace-gate/info"], "contains": ["Reading `{ws}/other` is fine"]}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "r1", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git -C {ws}/other log --oneline; sed -n 1,5p {ws}/x-kb/README.md"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "r2", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "cp {ws}/other/CLAUDE.md /dev/null"}},
   "expect": {"tags": ["workspace-gate/info"]}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "n1", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "sed -i 's/a/b/' README.md && cd {repo} && git commit -am x; echo hi > {tmp}/x.txt"}},
   "expect": {"empty": true}},
  {"note": "an unclosed quote falls back to plain splitting",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "w11", "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "rm '{ws}/other/a b"}},
   "expect": {"decision": "deny"}},
  {"note": "a lone surrogate in the command still denies (python used to fail on the deny log)",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": "{\"session_id\": \"w12\", \"hook_event_name\": \"PreToolUse\", \"tool_name\": \"Bash\", \"tool_input\": {\"command\": \"rm ../other/a \\udc80\"}}",
   "expect": {"decision": "deny"}}
 ]
}
