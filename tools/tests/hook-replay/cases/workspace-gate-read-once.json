{
 "description": "workspace-gate: reading another repo is an info note once per epoch; own-repo edits and the gate off switch pass",
 "env": {
  "HARNESS_WORKSPACE": "{ws}"
 },
 "steps": [
  {
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "PreToolUse",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "{ws}/other/CLAUDE.md"
    }
   },
   "expect": {
    "tags": [
     "workspace-gate/info"
    ],
    "contains": [
     "Reading `{ws}/other` is fine"
    ]
   },
   "argv": [
    "PreToolUse"
   ]
  },
  {
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "PreToolUse",
    "tool_name": "Grep",
    "tool_input": {
     "pattern": "x",
     "path": "{ws}/other"
    }
   },
   "expect": {
    "empty": true
   },
   "argv": [
    "PreToolUse"
   ]
  },
  {
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py",
   "payload": {
    "session_id": "s1",
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "{repo}/a.txt"
    }
   },
   "expect": {
    "empty": true
   },
   "argv": [
    "PreToolUse"
   ]
  },
  {
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py",
   "payload": {
    "session_id": "s2",
    "hook_event_name": "PreToolUse",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "{ws}/other/a.txt"
    }
   },
   "expect": {
    "empty": true
   },
   "argv": [
    "PreToolUse"
   ],
   "env": {
    "HARNESS_WORKSPACE_GATE": "off"
   }
  }
 ]
}
