{
 "description": "workspace-gate on odd input: non-object or broken JSON, a non-dict tool_input and a non-str cwd pass silently where python raises; non-str paths and session ids are str()-ed like python; a symlink into another repo and the home or config repo are not other repos",
 "setup": [
  "mkdir -p {ws}/other/rules {home}/.claude/rules && echo x > {ws}/other/rules/core.md && ln -s {ws}/other/rules/core.md {home}/.claude/rules/core.md"
 ],
 "steps": [
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"], "payload": "[1, 2]", "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"], "payload": "{\"tool_name\": ", "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": [], "payload": {"tool_name": "Edit", "tool_input": {"file_path": "{ws}/other/a"}}, "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": ["{ws}/other/a"]},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PostToolUse"],
   "payload": {"hook_event_name": "PostToolUse", "tool_name": "Skill", "tool_input": "qwreey-workspace:workspace"},
   "expect": {"empty": true}},
  {"note": "an absolute path does not need the cwd, so a numeric cwd still denies",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"cwd": 5, "hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "{ws}/other/a"}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"cwd": 5, "hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "../other/a"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"cwd": [1], "hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "rm /x"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": 5}},
   "expect": {"empty": true}},
  {"note": "str(['/../../other/x']) joined to the cwd climbs out of this repo",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": 7, "agent_id": {"k": [1.5, null, true]}, "hook_event_name": "PreToolUse", "tool_name": "Write", "tool_input": {"file_path": ["/../../other/x"]}},
   "expect": {"decision": "deny"}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": 0, "hook_event_name": "PreToolUse", "tool_name": "Read", "tool_input": {"pattern": "~/../ws/other/*.md", "path": 3}},
   "expect": {"contains": ["Reading `{ws}/other` is fine"]}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"session_id": "g1", "hook_event_name": "PreToolUse", "tool_name": "Glob", "tool_input": {"pattern": "{ws}/other/**/*.md"}},
   "expect": {"tags": ["workspace-gate/info"]}},
  {"note": "normpath only: the rules symlink is this session's file",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "~/.claude/rules/core.md"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "sed -i s/a/b/ {home}/.claude/rules/core.md"}},
   "expect": {"empty": true}},
  {"sh": "mkdir -p {cfg}/.git"},
  {"note": "the Claude config folder as a git repo (dotfiles) is not another repo",
   "hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Write", "tool_input": {"file_path": "{cfg}/projects/p/memory/MEMORY.md"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Write", "tool_input": {"file_path": "{ws}/other/a\u0000b"}},
   "expect": {"empty": true}},
  {"hook": "plugins/qwreey-workspace/scripts/workspace_gate.py", "argv": ["PreToolUse"],
   "payload": {"hook_event_name": "PreToolUse", "tool_name": "Write", "tool_input": {"file_path": "{ws}/other/a.txt"}},
   "env": {"HARNESS_WORKSPACE_GATE": " False "},
   "expect": {"empty": true}}
 ]
}
