{
  "description": "session-log: 판단만 하는 가벼운 훅. 요약은 setsid 로 분리한 워커가 한다. 상시 규약(context/ambient.md)은 ambient.py 가 SessionStart·SubagentStart 로 싣는다. 출력은 <harness-hook name=\"session-log\" level=…> 로 감싼 영어 한두 줄. subagent-slots.py 는 서브에이전트 고지·슬롯 훅이다.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" SessionStart", "timeout": 10 } ] },
      { "matcher": "startup|resume|clear|compact", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" SessionStart", "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" SubagentStart", "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-slots.py\"", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" UserPromptSubmit", "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" UserPromptSubmit", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Skill", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" PreToolUse", "timeout": 10 } ] },
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|Bash", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/workspace_gate.py\" PreToolUse", "timeout": 10 } ] },
      { "matcher": "Agent|Workflow", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-slots.py\"", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" PostToolUse", "timeout": 10 } ] },
      { "matcher": "Skill", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/workspace_gate.py\" PostToolUse", "timeout": 10 } ] },
      { "matcher": "*", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-slots.py\"", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "matcher": "manual|auto", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" PreCompact", "timeout": 30 } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" PostCompact", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-slots.py\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-slots.py\"", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" SessionEnd", "timeout": 5 } ] }
    ],
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/workspace_gate.py\" UserPromptExpansion", "timeout": 10 } ] }
    ]
  }
}
