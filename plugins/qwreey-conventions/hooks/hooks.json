{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/compact_epoch.py\" qwreey-conventions",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_inject.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-conventions",
            "args": [
              "hook",
              "conventions-check"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash_writes.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-conventions",
            "args": [
              "hook",
              "reuse-check"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-conventions",
            "args": [
              "hook",
              "structure-reminder"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-conventions",
            "args": [
              "hook",
              "memory-placement"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash_writes.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-conventions",
            "args": [
              "hook",
              "conventions-check"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-bypass-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
