{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/ambient.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/ambient.py\" SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/ambient.py\" PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-operator",
            "args": [
              "hook",
              "subagent-bg-tasks"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-operator",
            "args": [
              "hook",
              "delegate-nudge"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-operator",
            "args": [
              "hook",
              "delegate-nudge"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
