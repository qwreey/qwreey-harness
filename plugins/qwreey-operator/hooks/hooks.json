{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/ambient.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/delegate-nudge.py\"", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/delegate-nudge.py\"", "timeout": 5 }
        ]
      }
    ]
  }
}
