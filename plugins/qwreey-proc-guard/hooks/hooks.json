{
  "description": "heavy-proc-guard: 벤치·퍼저·성능 실측을 choom 으로 감싸지 않았으면 deny(Linux 전용, choom 이 없으면 아무것도 막지 않는다).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/heavy-proc-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
