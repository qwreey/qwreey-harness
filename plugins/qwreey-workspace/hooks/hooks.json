{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" SessionStart", "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" SubagentStart", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|Bash", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/workspace_gate.py\" PreToolUse", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Skill", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/workspace_gate.py\" PostToolUse", "timeout": 10 } ] }
    ],
    "PreCompact": [
      { "matcher": "manual|auto", "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/compact_epoch.py\" qwreey-workspace", "timeout": 5 }, { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" PreCompact", "timeout": 5 } ] }
    ],
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/workspace_gate.py\" UserPromptExpansion", "timeout": 10 } ] }
    ]
  }
}
