{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" SessionStart",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/stale_worktrees.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-workspace",
            "args": [
              "hook",
              "workspace-gate",
              "PreToolUse"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-workspace",
            "args": [
              "hook",
              "workspace-gate",
              "PostToolUse"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-workspace",
            "args": [
              "hook",
              "sibling-notice"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/compact_epoch.py\" qwreey-workspace",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/scripts/ambient.py\" PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-workspace",
            "args": [
              "hook",
              "workspace-gate",
              "UserPromptExpansion"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
