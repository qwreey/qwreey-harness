{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/compact_epoch.py\" qwreey-advisor",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/ambient.py\" PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 \"${CLAUDE_PLUGIN_ROOT}/hooks/ambient.py\" SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "ambient",
              "UserPromptSubmit"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "second-opinion-nudge"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "readonly-for-reviewers"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "second-opinion-nudge"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "expand-inherit-prompt"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "track-reviewer"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "second-opinion-nudge"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "second-opinion-nudge"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "second-opinion-nudge"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/native/qwreey-advisor",
            "args": [
              "hook",
              "second-opinion-nudge"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
