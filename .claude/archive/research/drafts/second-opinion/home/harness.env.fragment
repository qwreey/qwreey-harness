# --- 검토(second opinion) 등급. 저장소 이름=등급(high|mid|low|off). 근거: audit/18 §3 ---
# high: 게시된 라이브러리·공개 API·보안·하네스 정본(모든 세션에 퍼짐). mid: 활발한 앱·도구. low: 문서·소규모. off: 실험·위임 작업장
HARNESS_REVIEW_TIERS=quad=high stl-luau=high vitrine=high claude-doctor=high rbvm=mid table-sim=mid devplorer=mid tbox=mid coderag=mid VideoSync=mid luau-kb=low moonwave-luau=low mrow=low
# 목록에 없는 저장소(-agy, -scratch, -codex, /tmp 실험 등)
HARNESS_REVIEW_DEFAULT=off
# 커밋될 diff(추가+삭제 줄)가 이 이상이면 done 검토를 알린다. 0 = 알리지 않음
HARNESS_REVIEW_LINES=high=40 mid=200 low=0
# 이 시간(분) 안에 리뷰어가 끝났으면 다시 알리지 않는다
HARNESS_REVIEW_FRESH_MIN=90
# Stop 알림(커밋 안 된 큰 diff 로 턴을 끝낼 때). 첫 2주 원장을 보고 켤지 정한다
HARNESS_REVIEW_STOP=0
# ExitPlanMode 에서 high 등급 계획 검토: deny | warn | 빈 값(끔). 지금은 plan mode 사용이 0회라 끈다
HARNESS_REVIEW_PLAN=
