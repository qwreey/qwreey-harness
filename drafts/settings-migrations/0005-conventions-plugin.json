{
  "id": "0005-conventions-plugin",
  "why": "주석 위생 훅이 conventions 플러그인으로 옮겨 갔다(주석 문자·언어 검사와 모델용 문서 검사 포함). 예전 user-level 훅을 빼고 플러그인을 켠다. 초안: 확정되면 home/settings-migrations/ 로 옮긴다",
  "ops": [
    {
      "op": "hook-remove",
      "event": "PostToolUse",
      "command": "python3 $HOME/.claude/hooks/comment-hygiene.py"
    },
    {
      "op": "set",
      "path": [
        "enabledPlugins",
        "conventions@claude-doctor-market"
      ],
      "value": true,
      "keep_existing": true
    }
  ]
}
