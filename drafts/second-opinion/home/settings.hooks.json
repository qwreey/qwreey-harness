{
  "_comment": "home/.claude/settings.json 의 hooks 에 합칠 조각(초안). 기존 PreToolUse Bash 항목에는 command 하나만 더한다. ExitPlanMode·Stop 은 harness.env 로 켜야 동작한다. advisor 는 advisorModel 을 두지 않는 것으로 끈다(현재 상태). CLAUDE_CODE_DISABLE_ADVISOR_TOOL=1 은 --advisor 일회 사용까지 막으므로 사용자 결정(audit/18 §6).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $HOME/.claude/hooks/second-opinion-nudge.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $HOME/.claude/hooks/second-opinion-nudge.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "second-opinion-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $HOME/.claude/hooks/second-opinion-nudge.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $HOME/.claude/hooks/second-opinion-nudge.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
